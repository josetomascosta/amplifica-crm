generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("SALES")
  passwordHash  String?
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  deals       Deal[]      @relation("DealOwner")
  actividades Actividad[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Deal {
  id            String    @id @default(cuid())
  nombre        String
  etapa         String    @default("Cliente potencial")
  propietarioId String?
  propietario   User?     @relation("DealOwner", fields: [propietarioId], references: [id])
  monto         Float?
  moneda        String    @default("CLP")
  probabilidad  Float?
  fechaCierre   DateTime?

  perfilCliente      String?
  categoriasSeller   String?
  fuenteContacto     String?
  clasificacionLead  String?
  pedidosMensuales   Int?
  ticketPromedio     Float?
  ecommerce          String?
  appsDelivery       String?
  canalesActivos     String?
  tipoPlan           String?
  modeloCobro        String?
  cobroPorServicio   String?
  tarifaPorPedido    Float?
  sucursales         String?
  boost              String?
  fechaReunion       DateTime?
  fechaOnboarding    DateTime?
  fechaEnvioContrato DateTime?
  businessDeveloper  String?
  validadoPorTi      Boolean   @default(false)
  razonSocial        String?
  banco              String?
  resumenMarca       String?
  notasExcepciones   String?

  contactos   Contacto[]
  actividades Actividad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contacto {
  id       String  @id @default(cuid())
  nombre   String
  email    String? @unique
  telefono String?
  cargo    String?
  dealId   String?
  deal     Deal?   @relation(fields: [dealId], references: [id])

  createdAt DateTime @default(now())
}

model Actividad {
  id          String   @id @default(cuid())
  tipo        String
  titulo      String
  descripcion String?
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  autorId     String?
  autor       User?    @relation(fields: [autorId], references: [id])
  createdAt   DateTime @default(now())
}

model OKR {
  id          String      @id @default(cuid())
  objetivo    String
  descripcion String?
  trimestre   String
  activo      Boolean     @default(true)
  keyResults  KeyResult[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model KeyResult {
  id        String   @id @default(cuid())
  okrId     String
  okr       OKR      @relation(fields: [okrId], references: [id], onDelete: Cascade)
  titulo    String
  actual    Float    @default(0)
  objetivo  Float
  unidad    String   @default("unidades")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaMensual {
  id        String   @id @default(cuid())
  mes       String
  tipo      String
  assignee  String
  objetivo  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mes, tipo, assignee])
}

model Reunion {
  id         String   @id @default(cuid())
  fecha      DateTime
  bdNombre   String
  dealNombre String?
  realizada  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompromisoSemanal {
  id                  String  @id @default(cuid())
  semana              String  // "2026-W20"
  bdNombre            String
  compromisoReuniones Int     @default(0)
  logradoReuniones    Boolean @default(false)
  compromisoPedidos   Int     @default(0)
  logradoPedidos      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semana, bdNombre])
}



